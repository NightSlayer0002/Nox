{
  "name": "nox-first-contact",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "NOX: a small character with control over his own frame.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node scripts/build-client.mjs && node server.mjs",
    "dev": "node scripts/build-client.mjs && node --watch server.mjs",
    "build": "node scripts/build-vercel.mjs",
    "verify": "node --test && node scripts/check.mjs && node scripts/build-vercel.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@react-spring/web": "10.1.2",
    "@react-three/fiber": "9.8.1",
    "@shadergradient/react": "2.4.20",
    "camera-controls": "3.1.2",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-stdlib": "2.36.1"
  }
}
