# Copy to .env for local development. Set the same values in Vercel for hosting.
# Stay on the provider's Free plan; do not enable billing for a free-only setup.
NOX_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Natural voice is optional and uses Groq's separate speech quota.
NOX_NATURAL_VOICE=1
NOX_SPEECH_PROVIDER=groq
NOX_SPEECH_VOICE=troy

# REQUIRED for cloud AI access. Generate a long random token, separate from API keys.
# Keep it private. Unlock the hosted app in Settings for each visit.
NOX_ACCESS_TOKEN=
# Only needed for custom domains; e.g. https://nox.example.com (no trailing path).
NOX_PUBLIC_ORIGIN=

# Legacy optional paid integration. Leave blank for this free-only setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
