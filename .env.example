# Copy to .env for local development. Set the same values in Vercel for hosting.
# Stay on the provider's Free plan; do not enable billing for a free-only setup.
NOX_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Natural voice is optional and uses Groq's separate speech quota.
NOX_NATURAL_VOICE=1
NOX_SPEECH_PROVIDER=groq
NOX_SPEECH_VOICE=troy

# Required to protect hosted private developer tools, not public guest chat/voice.
# Generate a long random token, separate from API keys, and keep it private.
# Unlock creates a cookie session for up to 12 hours on this host; it is not Plus.
NOX_ACCESS_TOKEN=
# Only needed for custom domains; e.g. https://nox.example.com (no trailing path).
NOX_PUBLIC_ORIGIN=

# Optional shared daily public allowances. Keep both REST credentials server-side.
# With both blank, guests get a rate-limited preview, not a durable daily allowance.
# Partially configured credentials or an unavailable store fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate accepted text/speech request budgets per public IP/shared network.
# Defaults are 20 messages and 30 natural-voice requests; reset at midnight UTC.
# These are not per-person account limits or voice-minute allowances.
NOX_FREE_TEXT_DAILY=20
NOX_FREE_SPEECH_DAILY=30

# Legacy optional paid integration. Leave blank for this free-only setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
